# EdgeDeploy Environment Configuration

# Database Configuration (MariaDB / MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edgedeploy

# Auth Secrets
JWT_SECRET=super_secret_jwt_key_edgedeploy_2026
JWT_EXPIRES_IN=24h

# Admin Credentials (for seed script)
ADMIN_EMAIL=admin@edgedeploy.local
ADMIN_PASSWORD=AdminPassword123!

# Service Ports & Host Configuration
BACKEND_PORT=3001
ORIGIN_PORT=4000
GATEWAY_PORT=8080
EDGE_NODE_PORTS=4101,4102,4103
EDGE_REGIONS=Mumbai,Ahmedabad,Delhi

# Webhook & Internal Security
PUBLIC_WEBHOOK_URL=http://localhost:3001
INTERNAL_API_TOKEN=internal_secret_token_edgedeploy_8832

# Storage Root Path (relative or absolute)
STORAGE_PATH=./storage

# Cache Settings
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=100

# Rate Limiter Settings (Token Bucket)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=2

# Build Service Settings
BUILD_TIMEOUT_MS=300000
MAX_LOG_BYTES=1048576
BUILD_CONCURRENCY=2
KEEP_DEPLOYMENTS=5

# Health Check & Gateway Settings
HEALTH_INTERVAL_MS=5000
ALLOW_LOCAL_REPOS=true
TRUST_PROXY=true
CORS_ORIGIN=http://localhost:3000
